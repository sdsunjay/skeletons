# ~/.bash_aliases -- sourced by ~/.bashrc (and safe to source from ~/.zshrc).
# Targets macOS (BSD userland); falls back to GNU flags where coreutils are in use.

# System Commands
# Color output: GNU ls understands --color, BSD (macOS) ls uses -G.
if ls --color=auto -d . >/dev/null 2>&1; then
    command -v dircolors >/dev/null 2>&1 && eval "$(dircolors -b)"
    alias ls='ls --color=auto -h'
else
    export CLICOLOR=1
    alias ls='ls -Gh'
fi
alias grep='grep --color=auto'
alias ll='ls -lA'

alias mounts='mount | column -t'   # don't shadow mount itself, it breaks `mount <dev>`
alias gc='gcc -ansi -Wall -pedantic-errors'
alias rm='rm -i'
alias mkdir='mkdir -pv'

# Helpful for my website
alias rsyn="rsync -av --exclude 'CMD' --exclude 'RS' --exclude 'blog' --exclude 'protected' --exclude 'vim' --exclude 'security' --exclude '*.jpg' --exclude '*.JPG' --exclude '*.jpeg' --exclude '*.JPEG' --exclude '*.png' --exclude '*.mov' --exclude '*.MOV' --exclude 'Resume.pdf' -e 'ssh -p 73' root@172.245.22.244:/usr/share/nginx/html ."
alias findBigFiles='find . -type f -exec du -k {} + 2>/dev/null | sort -nr | head -10'

# Aliases can't take positional args ($1 $2 $3 expanded to nothing), so call the script directly.
scpMe() { "$HOME/cpe/usefulScripts/scpMe.sh" "$@"; }

# OS X specific
alias vlc='/Applications/VLC.app/Contents/MacOS/VLC'

#############################

# System information shortcuts (macOS equivalents of free/lscpu/Xorg)
alias meminfo='top -l 1 -s 0 | grep PhysMem; vm_stat'

## get top process eating memory
alias psmem='ps aux -m'
alias psmem10='ps aux -m | head -11'

## get top process eating cpu
alias pscpu='ps aux -r'
alias pscpu10='ps aux -r | head -11'

## Get cpu info
alias cpuinfo='sysctl -n machdep.cpu.brand_string; sysctl hw.physicalcpu hw.logicalcpu hw.memsize'

## get GPU info (VRAM, displays)
alias gpumeminfo='system_profiler SPDisplaysDataType'

## set some other defaults
alias quota='df -H'
alias df='df -H'
alias du='du -ch'

# Aliases copied from Eriq

################
alias quit='exit'

alias valgrindfull='valgrind --leak-check=full --show-reachable=yes --track-origins=yes'

alias myip='curl -fsS https://api.ipify.org; echo'

# Keep the display awake until Ctrl-C (xset doesn't exist on macOS)
alias noSleep='caffeinate -d'
################

mkcd() {
    mkdir -p -- "$1" && cd -- "$1"
}
